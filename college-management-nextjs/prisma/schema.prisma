generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  password         String
  userType         UserType
  studentId        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attendance       Attendance[]
  coursesAsTeacher Course[]     @relation("TeacherCourses")
  enrollments      Enrollment[]
  marks            Mark[]
  queries          Query[]

  @@index([email])
  @@index([userType])
}

model Course {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  description String?
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendance  Attendance[]
  content     Content[]
  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  marks       Mark[]
  queries     Query[]

  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Mark {
  id        String         @id @default(cuid())
  studentId String
  courseId  String
  type      AssessmentType
  score     Float
  date      DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([studentId])
  @@index([courseId])
}

model Content {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  fileName    String?
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Query {
  id           String    @id @default(cuid())
  studentId    String
  courseId     String
  subject      String
  message      String
  answer       String?
  answeredDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
}

enum UserType {
  TEACHER
  STUDENT
}

enum AssessmentType {
  ASSIGNMENT
  QUIZ
  MIDTERM
  FINAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}
